# ==============================================================================
# Multi-Vendor Marketplace — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
APP_NAME="Multi-Vendor Marketplace API"
APP_VERSION=1.0.0

# Database Configuration (PostgreSQL with asyncpg driver)
POSTGRES_USER=marketplace_user
POSTGRES_PASSWORD=marketplace_pass
POSTGRES_DB=marketplace_db
DATABASE_URL=postgresql+asyncpg://marketplace_user:marketplace_pass@localhost:5432/marketplace_db

# Security & JWT (Generate a 32+ character random string for production)
# e.g., openssl rand -hex 32
SECRET_KEY=change-this-secret-key-to-a-secure-random-value-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000,http://127.0.0.1:8000

# Observability
LOG_LEVEL=INFO
CORRELATION_ID_HEADER=X-Request-ID

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_PAYMENTS_PER_MINUTE=20
RATE_LIMIT_REVIEWS_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=120

